      <state_interface name="position"><param name="initial_value">-1.45</param></state_interface>
      <state_interface name="velocity"/>
      <param name="pos_kp">40.0</param>
      <param name="pos_ki">0.0</param>
      <param name="pos_kd">0.3</param>
    </joint>

    <joint name="RL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <param name="pos_kp">40.0</param>
      <param name="pos_ki">0.0</param>
      <param name="pos_kd">0.3</param>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.85</param></state_interface>
      <state_interface name="velocity"/>
      <param name="pos_kp">40.0</param>
      <param name="pos_ki">0.0</param>
      <param name="pos_kd">0.3</param>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.45</param></state_interface>
      <state_interface name="velocity"/>
      <param name="pos_kp">40.0</param>
      <param name="pos_ki">0.0</param>
      <param name="pos_kd">0.3</param>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find a1_description)/config/a1_controllers.yaml</parameters>
    </plugin>
  </gazebo>

