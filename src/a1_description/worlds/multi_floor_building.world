      <!-- 5. Third Floor Platform (Top surface at z = 3.00m, West Deck + Ramp Arrival Landing) -->
      <link name="third_floor_platform">
        <!-- Main West Deck: x in [-6.90, -0.50], y in [-5.90, +2.70] -->
        <collision name="f3_main_collision">
          <pose>-3.70 -1.60 2.93 0 0 0</pose>
          <geometry><box><size>6.40 8.60 0.14</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="f3_main_visual">
          <pose>-3.70 -1.60 2.93 0 0 0</pose>
          <geometry><box><size>6.40 8.60 0.14</size></box></geometry>
          <material><ambient>0.55 0.58 0.68 1</ambient></material>
        </visual>

        <!-- Ramp Arrival Deck: x in [-6.90, -4.50], y in [+2.70, +5.90] (2.4m wide landing) -->
        <collision name="f3_landing_collision">
          <pose>-5.70 4.30 2.93 0 0 0</pose>
          <geometry><box><size>2.40 3.20 0.14</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="f3_landing_visual">
