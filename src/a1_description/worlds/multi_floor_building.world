        <!-- Ramp 2->3 South Guard Wall -->
        <collision name="ramp23_guard_south">
          <pose>-1.50 2.70 2.65 0 0.245 0</pose>
          <geometry><box><size>6.20 0.15 0.90</size></box></geometry>
