          <material><ambient>0.30 0.56 0.78 1</ambient></material>
        </visual>
        <!-- Stair Step 8/15 (x=-1.50, z_top=2.30m) -->
        <collision name="stair23_col_8">
          <pose>-1.50 3.80 1.900 0 0 0</pose>
          <geometry><box><size>0.40 2.20 0.800</size></box></geometry>
