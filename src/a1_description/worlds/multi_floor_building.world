        </visual>
        <!-- Stair Step 9/15 (x=-1.90, z_top=2.40m) -->
        <collision name="stair23_col_9">
          <pose>-1.90 3.80 1.950 0 0 0</pose>
          <geometry><box><size>0.40 2.20 0.900</size></box></geometry>
