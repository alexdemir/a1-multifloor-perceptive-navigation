          <material><ambient>0.23 0.47 0.69 1</ambient></material>
        </visual>
        <!-- Stair Step 3/15 (x=0.50, z_top=1.80m) -->
        <collision name="stair23_col_3">
          <pose>0.50 3.80 1.650 0 0 0</pose>
          <geometry><box><size>0.40 2.20 0.300</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
